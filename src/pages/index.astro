---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<Base>
  <main>
    <div class="container">

      <div class="hero">
        <div class="hero-eyebrow">Backend engineer</div>
        <h1>Building systems<br>that <em>scale and secure.</em></h1>
        <p>
          I work on cloud infrastructure, distributed systems, and security tooling.
          Occasionally I write about what I learn along the way.
        </p>
        <div class="hero-links">
          <a class="btn btn-primary" href="https://github.com/Parag953" target="_blank" rel="noopener">
            GitHub →
          </a>
          <a class="btn btn-ghost" href="mailto:parag@andromedasecurity.com">
            Get in touch
          </a>
        </div>
      </div>

      <hr class="divider">

      <section id="writing">
        <p class="section-label">Writing</p>
        {posts.length === 0 ? (
          <div class="post-coming">Articles coming soon — check back later.</div>
        ) : (
          <div class="post-list">
            {posts.map(post => (
              <a class="post-item" href={`/posts/${post.slug}`}>
                <span class="post-title">{post.data.title}</span>
                <span class="post-meta">
                  {post.data.date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
                </span>
              </a>
            ))}
          </div>
        )}
      </section>

      <hr class="divider">

      <section id="about">
        <p class="section-label">About</p>
        <p class="about-text">
          I'm a backend engineer focused on <strong>cloud infrastructure</strong>,
          <strong>Kubernetes</strong>, and <strong>security platforms</strong>.
          I care about systems that are observable, resilient, and don't surprise you at 2 am.
        </p>
      </section>

    </div>
  </main>
</Base>

<style>
  .hero { padding: 72px 0 56px; }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 500;
    color: var(--accent);
    background: var(--accent-light);
    padding: 4px 10px;
    border-radius: 999px;
    margin-bottom: 20px;
  }

  .hero-eyebrow::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .hero h1 {
    font-family: 'Lora', Georgia, serif;
    font-size: clamp(36px, 6vw, 52px);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin-bottom: 20px;
  }

  .hero h1 em { font-style: italic; color: var(--muted); }

  .hero > p {
    font-size: 17px;
    color: var(--muted);
    max-width: 540px;
    line-height: 1.7;
    margin-bottom: 32px;
  }

  .hero-links { display: flex; gap: 12px; flex-wrap: wrap; }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 18px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.15s;
  }

  .btn-primary { background: var(--accent); color: #fff; }
  .btn-primary:hover { opacity: 0.88; }
  .btn-ghost { border: 1px solid var(--border); color: var(--text); }
  .btn-ghost:hover { background: var(--surface); }

  .divider { border: none; border-top: 1px solid var(--border); margin: 8px 0; }

  section { padding: 48px 0; }

  .section-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 28px;
  }

  .post-list { display: flex; flex-direction: column; gap: 2px; }

  .post-item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: var(--text);
    transition: color 0.15s;
  }

  .post-item:first-child { border-top: 1px solid var(--border); }
  .post-item:hover .post-title { color: var(--accent); }

  .post-title { font-size: 15px; font-weight: 500; transition: color 0.15s; }
  .post-meta { font-size: 13px; color: var(--muted); white-space: nowrap; flex-shrink: 0; }

  .post-coming {
    padding: 32px;
    background: var(--surface);
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    text-align: center;
    color: var(--muted);
    font-size: 14px;
  }

  .about-text {
    font-family: 'Lora', Georgia, serif;
    font-size: 16px;
    line-height: 1.8;
    color: var(--muted);
  }

  .about-text strong { color: var(--text); font-weight: 500; }

  @media (max-width: 480px) {
    .hero { padding: 48px 0 40px; }
  }
</style>
