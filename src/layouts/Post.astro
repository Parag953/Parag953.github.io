---
import Base from './Base.astro';

interface Props {
  title: string;
  date: Date;
  description?: string;
}

const { title, date, description } = Astro.props;
const formatted = date.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
---
<Base title={`${title} · Parag`}>
  <main>
    <div class="container">
      <a class="back" href="/">← All posts</a>
      <header>
        <h1>{title}</h1>
        <p class="meta">{formatted}</p>
        {description && <p class="description">{description}</p>}
      </header>
      <article>
        <slot />
      </article>
    </div>
  </main>
</Base>

<style>
  .container {
    padding: 48px 0 80px;
  }

  .back {
    font-size: 14px;
    color: var(--muted);
    text-decoration: none;
    display: inline-block;
    margin-bottom: 32px;
    transition: color 0.15s;
  }

  .back:hover { color: var(--text); }

  header { margin-bottom: 40px; }

  h1 {
    font-family: 'Lora', Georgia, serif;
    font-size: clamp(28px, 5vw, 40px);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: 10px;
  }

  .meta {
    font-size: 13px;
    color: var(--muted);
  }

  .description {
    font-size: 16px;
    color: var(--muted);
    margin-top: 12px;
    line-height: 1.6;
  }

  article {
    font-size: 17px;
    line-height: 1.8;
    max-width: 640px;
  }

  article :global(h2) {
    font-family: 'Lora', Georgia, serif;
    font-size: 24px;
    font-weight: 400;
    margin: 40px 0 16px;
  }

  article :global(h3) {
    font-size: 18px;
    font-weight: 600;
    margin: 32px 0 12px;
  }

  article :global(p) { margin-bottom: 20px; }

  article :global(p + p) { margin-top: 0; }

  article :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  article :global(code) {
    font-family: 'Menlo', 'Monaco', monospace;
    font-size: 14px;
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 2px 6px;
    border-radius: 4px;
  }

  article :global(pre) {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
    overflow-x: auto;
    margin: 24px 0;
  }

  article :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    font-size: 13px;
  }

  article :global(ul), article :global(ol) {
    padding-left: 24px;
    margin-bottom: 20px;
  }

  article :global(li) { margin-bottom: 6px; }

  article :global(blockquote) {
    border-left: 3px solid var(--border);
    padding-left: 20px;
    color: var(--muted);
    margin: 24px 0;
    font-style: italic;
  }

  article :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 40px 0;
  }
</style>
